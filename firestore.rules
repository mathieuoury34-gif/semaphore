rules_version = '2';
// Projet Firebase DÉDIÉ à Sémaphore (distinct de celui de PEAnalyze).
// Chaque utilisateur connecté n'accède qu'à ses propres données (users/{uid}/…) ;
// Sémaphore range les siennes sous users/{uid}/semaphore/main.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
