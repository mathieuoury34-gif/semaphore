rules_version = '2';
// Chaque utilisateur connecté n'accède qu'à ses propres données (users/{uid}/…).
// Vigie range les siennes sous users/{uid}/vigie/main.
//
// ATTENTION : si Vigie partage le projet Firebase de PEAnalyze (configuration par défaut), NE PAS publier ce fichier :
// les règles de PEAnalyze (qui contiennent aussi watch/{uid}) couvrent déjà users/{uid}/** et suffisent.
// Ce fichier ne sert que pour un projet Firebase dédié à Vigie.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
