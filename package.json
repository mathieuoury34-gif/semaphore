{
  "name": "semaphore",
  "version": "1.0.0",
  "private": true,
  "description": "Sémaphore – veille d'actualité personnelle par secteurs, résumés en français",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --serve",
    "collect": "node scripts/collect/run.mjs",
