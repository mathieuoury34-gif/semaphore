    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@mozilla/readability": "0.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "fast-xml-parser": "5.11.2",
    "jsdom": "30.1.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  }
}
